PORT=3001
NODE_ENV=development

# Local SQLite file. Ignored on Render if DATABASE_URL is set.
DATABASE_PATH=./data/letters.db

# Render Postgres internal URL. When set, SQLite is not used.
# DATABASE_URL=postgres://...

# Required to view /admin and export letters (with names) for Wembley.
ADMIN_KEY=change-me

# Optional extra salt for hashing visitor IPs.
IP_SALT=pratyaksh-93

# ISO datetime. Leave unset to keep the form open.
# CLOSES_AT=2026-10-03T23:59:00+01:00
